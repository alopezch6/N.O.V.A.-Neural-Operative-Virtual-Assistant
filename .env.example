# ── APIs ──────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
TMDB_API_KEY=your_tmdb_api_key_here
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_ID=your_telegram_user_id_here

# ── Alexa TTS (opcional — poner USE_ALEXA_TTS=False en config.py para desactivar) ──
ALEXA_EMAIL=your_amazon_account_email
ALEXA_PASSWORD=your_amazon_account_password

# ── Infraestructura ───────────────────────────────────────────────────────────
OLLAMA_HOST_ORACLE=http://<oracle-tailscale-ip>:11434
ALMACEN_URL=http://<oracle-tailscale-ip>:9101
ALMACEN_TOKEN=your_sync_token_here
PC_TAILSCALE_IP=<local-pc-tailscale-ip>

# ── Rutas locales ─────────────────────────────────────────────────────────────
NOVA_DIR=C:\path\to\nova
VOSK_MODEL_PATH=C:\path\to\nova\vosk-model-small-es-0.42
